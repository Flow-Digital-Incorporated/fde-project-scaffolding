# Do not copy this file to .env in the project folder (it syncs to Google Drive).
# Onboarding copies this file to ~/.claude/clients/CLIENT/.env and links .env to it.
# ALL secrets live in that .env, never in code files, specs, or docs.
# Reference them elsewhere by variable name only.
# After adding the API key, remove the pound symbol to starting using the API/PAT

# Airtable
# AIRTABLE_PAT=

# Softr
# SOFTR_API_KEY=

# Zapier / Make
# ZAPIER_WEBHOOK_SECRET=
# MAKE_API_TOKEN=

# HubSpot / Pipedrive
# HUBSPOT_PRIVATE_APP_TOKEN=
# PIPEDRIVE_API_TOKEN=
