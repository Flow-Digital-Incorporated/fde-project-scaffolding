# Copy this file to `.env` if `.env` is missing (fresh clone from git —
# `.env` itself is gitignored and never leaves the machine it's on).
# ALL secrets live in `.env` — never in code files, specs, or docs.
# Reference them elsewhere by variable name only.

# Airtable
# AIRTABLE_PAT=

# Softr
# SOFTR_API_KEY=

# Zapier / Make
# ZAPIER_WEBHOOK_SECRET=
# MAKE_API_TOKEN=

# HubSpot / Pipedrive
# HUBSPOT_PRIVATE_APP_TOKEN=
# PIPEDRIVE_API_TOKEN=
