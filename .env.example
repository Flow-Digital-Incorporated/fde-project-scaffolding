# Do not copy this file to .env in the project folder (it syncs to Google Drive).
# Onboarding copies this file to ~/.claude/clients/CLIENT/.env and links .env to it.
# This file holds ONLY op:// references. The keys themselves live in 1Password.
# To add a key: copy it, then tell Claude "save my clipboard to 1Password in the
# <Client> vault as <Tool> API (<Client>)". Claude fills in the reference below.
# Remove the # in front of a line once its reference is filled in.
# Run tools with: op run --env-file=.env -- <command>

# Airtable
# AIRTABLE_PAT=op://<vault id>/<item id>/credential

# Softr
# SOFTR_API_KEY=op://<vault id>/<item id>/credential

# Zapier / Make
# ZAPIER_WEBHOOK_SECRET=op://<vault id>/<item id>/credential
# MAKE_API_TOKEN=op://<vault id>/<item id>/credential

# HubSpot / Pipedrive
# HUBSPOT_PRIVATE_APP_TOKEN=op://<vault id>/<item id>/credential
# PIPEDRIVE_API_TOKEN=op://<vault id>/<item id>/credential
